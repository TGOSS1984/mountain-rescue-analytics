node_modules/
dist/
.env
.env.local
*.log

# pipeline outputs — regenerated by scripts, don't commit
pipeline/data/raw/
pipeline/data/interim/
pipeline/data/processed/*.parquet
# incidents.db is DELIBERATELY committed, not ignored — Render's free
# tier has an ephemeral filesystem (wiped on every deploy), and
# regenerating it there would mean re-running geocoding against
# Nominatim's ~1 req/sec rate limit on every single deploy, which is
# both painfully slow and an unreasonable load against a free service
# meant for occasional real usage, not CI. The dataset is small,
# rebuilt periodically and locally, not live-write — committing the
# built database is the right call here, not a shortcut. Only the CSV
# intermediate is still ignored.
pipeline/data/processed/incidents_geocoded.csv

__pycache__/
*.pyc
.venv/
.pytest_cache/
