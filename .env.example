# Copy this to .env.local for local development (gitignored, so your
# own values never get committed). Vite only exposes variables
# prefixed VITE_ to the browser — see src/api/client.js.

# Left unset, the app falls back to http://localhost:8000, which is
# right for local dev against `uvicorn main:app --reload`. Only needs
# setting explicitly when pointing at something else — most commonly,
# set this in Vercel's dashboard (Settings -> Environment Variables)
# once the API is deployed, to the real Render URL.
VITE_API_BASE=http://localhost:8000